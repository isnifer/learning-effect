{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "packages/api/migrations/**",
    "packages/api/src/components/ui/**",
    "packages/api/src/routeTree.gen.ts"
  ],
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "arrowParens": "avoid",
  "experimentalSortImports": {
    "groups": [
      "builtin",
      "external",
      "internal",
      "subpath",
      "parent",
      "sibling",
      "index",
      "import",
      "style"
    ],
    "newlinesBetween": false
  },
  "experimentalTailwindcss": {}
}
